{
  "name": "adflow-admin-console",
  "private": true,
  "version": "0.1.0",
  "description": "投流统计平台 · 管理端（Vue3 + TypeScript + Element Plus，本地模拟数据）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite --mode backend",
    "build": "vue-tsc --noEmit && vite build",
    "build:backend": "vue-tsc --noEmit && vite build --mode backend",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --ext .vue,.ts,.cjs --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json,mjs}\"",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "axios": "1.7.2",
    "dayjs": "1.11.11",
    "echarts": "5.5.1",
    "element-plus": "2.7.6",
    "pinia": "2.1.7",
    "vue": "3.4.31",
    "vue-router": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-vue": "5.0.5",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.27.0",
    "playwright-core": "1.65.1",
    "prettier": "3.3.3",
    "typescript": "5.4.5",
    "vite": "5.2.13",
    "vitest": "1.6.0",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.0.29"
  }
}
